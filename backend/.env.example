# Placeholder environment template — see docs/14_DEVELOPER_GUIDE.md § 6 for full explanation.
# Copy to .env and fill in real values. Never commit the real .env file.

# Server
PORT=4000
# 0.0.0.0 = listen on every network interface (LAN-reachable from phones/tablets, and what
# containers/PaaS platforms expect in production). Use 127.0.0.1 to restrict to loopback-only.
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=*
# This backend's own public URL (e.g. https://api.surfpos.example, or an ngrok tunnel in dev) —
# enables Surfboard's redirect-back-to-app and webhook mechanisms (see
# docs/23_ENVIRONMENT_CONFIGURATION.md and modules/payments/payment.service.js). Surfboard
# rejects both non-http(s) schemes and private/loopback addresses for these fields, so leave this
# unset on a typical local-LAN dev machine — Checkout still works fully via status polling.
PUBLIC_BASE_URL=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# AI
GEMINI_API_KEY=
OCR_PROVIDER_API_KEY=

# Surfboard Payments
SURFBOARD_API_KEY=
SURFBOARD_API_SECRET=
SURFBOARD_WEBHOOK_SECRET=
SURFBOARD_ENV=sandbox
# Surfboard SDK authentication strategy: api_key | api_key_secret | bearer | oauth (see
# docs/15_SURFBOARD_INTEGRATION.md § 2). api_key_secret is confirmed correct (sends both
# SURFBOARD_API_KEY and SURFBOARD_API_SECRET as API-KEY/API-SECRET headers) for the Merchant
# Onboarding API family — see docs/08_ARCHITECTURE_DECISIONS.md § ADR-025.
SURFBOARD_AUTH_STRATEGY=api_key_secret
# Only used when SURFBOARD_AUTH_STRATEGY=bearer and no dynamic token fetcher is configured
SURFBOARD_BEARER_TOKEN=
# Partner-gateway credentials (e.g. a white-label deployment) — separate from the api_key/bearer/oauth
# strategies above; SURFBOARD_API_URL overrides the default sandbox/production base URL when set.
SURFBOARD_PARTNER_ID=
SURFBOARD_API_URL=
SURFBOARD_SECRET_KEY=
# Required, one-time-only per store (Surfboard's Update Store Details "onlineInfo" can never be
# changed again after it's first set — see docs/23_ENVIRONMENT_CONFIGURATION.md and
# payment.service.js#ensureStoreOnlineInfo). Defaults to https://example.com if unset — fine for
# sandbox/TEST_MERCHANT testing, but replace with your merchant's real webshop/terms/privacy URLs
# before processing any real payment.
SURFBOARD_ONLINE_STORE_WEBSHOP_URL=
SURFBOARD_ONLINE_STORE_TERMS_URL=
SURFBOARD_ONLINE_STORE_PRIVACY_URL=