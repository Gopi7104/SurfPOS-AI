// Placeholder Firebase Storage Security Rules — deny-all default.
// See docs/03_DATABASE_DESIGN.md and docs/07_CODING_RULES.md § 16 before authoring real rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
