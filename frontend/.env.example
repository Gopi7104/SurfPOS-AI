# Local development configuration — see docs/23_ENVIRONMENT_CONFIGURATION.md.
# Copy this file to .env (never commit the real .env — see .gitignore) and fill in real values.
#
# Only used for development builds (AppEnvironment.development, the default). Staging/production
# builds always get their backend URL from --dart-define=API_BASE_URL=... instead — see
# docs/23_ENVIRONMENT_CONFIGURATION.md.
#
# Default below (recommended) points at the deployed Render backend — no local backend, adb
# reverse, or LAN IP needed. If you ever need to run the backend locally instead, see
# docs/23_ENVIRONMENT_CONFIGURATION.md for the USB/Wi-Fi/emulator alternatives:
#   - Physical device via USB:    http://127.0.0.1:4000  (with `adb reverse tcp:4000 tcp:4000`,
#                        or run `frontend/scripts/run_usb.sh` instead of `flutter run`)
#   - Physical device via Wi-Fi:  http://<YOUR_MACHINE_LAN_IP>:<port>
#   - Android emulator:  http://10.0.2.2:<port>
#   - iOS simulator:     http://localhost:<port>
API_BASE_URL=https://surfpos-ai.onrender.com
